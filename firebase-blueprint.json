{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Server-provisioned admin role markers readable by self or existing admins and strictly immutable from client SDKs.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        }
      },
      "required": ["uid", "role"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private user account metadata containing PII such as email.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "likedPoemIds": {
          "type": "array",
          "description": "Up to 500 liked poem IDs saved for the user."
        },
        "likedRadioTrackIds": {
          "type": "array",
          "description": "Up to 500 liked radio track IDs saved for the user."
        },
        "donorChatText": {
          "type": "string",
          "maxLength": 120
        },
        "totalTimeSeconds": {
          "type": "number"
        },
        "lastSeenAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt"]
    },
    "PublicUserProfile": {
      "title": "PublicUserProfile",
      "description": "Public non-PII user profile used for leaderboards, badges, likes, and chat display. System fields (purchasesCount, totalTimeSeconds, donorChatText, guestUid) are admin/server-only.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "guestUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "likedPoemIds": {
          "type": "array",
          "description": "Up to 500 liked poem IDs."
        },
        "likedRadioTrackIds": {
          "type": "array",
          "description": "Up to 500 liked radio track IDs."
        },
        "totalTimeSeconds": {
          "type": "number"
        },
        "purchasesCount": {
          "type": "number"
        },
        "donorChatText": {
          "type": "string",
          "maxLength": 80
        },
        "lastSeenAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Public reader comment and optional rating (0.1-5.0) on a poem, prose work, or store book. Rating is immutable after creation; owner may only update comment.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "enum": ["poem", "prose", "product"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorPhotoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "rating": {
          "type": ["number", "null"],
          "description": "Optional swipeable rating from 0.1 to 5.0 or null for comment-only reviews"
        },
        "comment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "targetType", "targetId", "authorUid", "authorName", "rating", "comment", "createdAt"]
    },
    "WorkVote": {
      "title": "WorkVote",
      "description": "Per-user persisted rating (0.1-5.0) for a poem, prose work, or store product.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "enum": ["poem", "prose", "product"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rating": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "targetType", "targetId", "userId", "rating", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Global community chat message.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorPhotoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "isAdmin": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "replyTo": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "authorUid", "authorName", "text", "createdAt"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Verified supporter donation entry displayed on the donor leaderboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "guestUid": {
          "type": "string",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "amountUah": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "donatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "displayName", "amountUah", "donatedAt", "createdAt"]
    },
    "RadioTrack": {
      "title": "RadioTrack",
      "description": "SoundCloud track entry persisted in the site radio playlist.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "soundcloudUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "pattern": "^https?://.+"
        },
        "embedTargetUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "pattern": "^https?://.+"
        },
        "artworkUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "station": {
          "type": "string",
          "enum": ["indie", "electronic"]
        },
        "order": {
          "type": "number",
          "description": "Zero-based sequential playback position in the radio loop."
        },
        "visibility": {
          "type": "string",
          "enum": ["authenticated"]
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "artist",
        "soundcloudUrl",
        "embedTargetUrl",
        "artworkUrl",
        "station",
        "order",
        "visibility",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Persisted home page copy, author photos, social links, interviews, prose tags, and discount configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "heroLeadText": { "type": "string", "minLength": 0, "maxLength": 2000 },
        "authorAboutText": { "type": "string", "minLength": 0, "maxLength": 10000 },
        "authorPhotoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "authorPhotos": { "type": "array", "description": "Up to 20 author photo URLs." },
        "socialLinks": { "type": "array", "description": "Up to 20 social link entries." },
        "monobankJarUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "monobankModalTitle": { "type": "string", "minLength": 0, "maxLength": 120 },
        "monobankModalSubtitle": { "type": "string", "minLength": 0, "maxLength": 300 },
        "monobankCardLabel": { "type": "string", "minLength": 0, "maxLength": 80 },
        "monobankModalText": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "monobankEmptyText": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "contactEmail": { "type": "string", "minLength": 0, "maxLength": 254 },
        "interviews": { "type": "array", "description": "Up to 50 interview items." },
        "homeActionAboutTitle": { "type": "string", "minLength": 0, "maxLength": 120 },
        "homeActionContactTitle": { "type": "string", "minLength": 0, "maxLength": 120 },
        "homeActionMonobankTitle": { "type": "string", "minLength": 0, "maxLength": 120 },
        "homeActionInterviewsTitle": { "type": "string", "minLength": 0, "maxLength": 120 },
        "homeRepeaters": {
          "type": "object",
          "description": "Admin configuration for the 4 home page repeaters (mode and item count)."
        },
        "proseAuthDiscountPercent": { "type": "number" },
        "proseTelegramDiscountPercent": { "type": "number" },
        "telegramChannelId": { "type": "string", "minLength": 0, "maxLength": 200 },
        "storeAuthDiscountPercent": { "type": "number" },
        "proseTags": { "type": "array", "description": "Up to 50 prose tag definitions." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "heroLeadText",
        "authorAboutText",
        "authorPhotoUrl",
        "authorPhotos",
        "socialLinks",
        "monobankJarUrl",
        "contactEmail",
        "interviews",
        "homeActionAboutTitle",
        "homeActionContactTitle",
        "homeActionMonobankTitle",
        "homeActionInterviewsTitle",
        "proseAuthDiscountPercent",
        "storeAuthDiscountPercent",
        "proseTags",
        "updatedAt"
      ]
    },
    "Poem": {
      "title": "Poem",
      "description": "Persisted poem entry for the Poetry section.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "cycle": { "type": "string", "minLength": 0, "maxLength": 160 },
        "year": { "type": "number" },
        "excerpt": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "content": { "type": "string", "minLength": 0, "maxLength": 50000 },
        "note": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "fontSize": { "type": "string", "minLength": 0, "maxLength": 10 },
        "textAlign": { "type": "string", "minLength": 0, "maxLength": 10 },
        "lineSpacing": { "type": "string", "minLength": 0, "maxLength": 10 },
        "textColor": { "type": "string", "minLength": 0, "maxLength": 32 },
        "backgroundColor": { "type": "string", "minLength": 0, "maxLength": 32 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "imagePalette": {
          "type": "object",
          "description": "Extracted dominant color palette for the poem image.",
          "properties": {
            "background": { "type": "string", "minLength": 4, "maxLength": 32 },
            "secondaryBackground": { "type": "string", "minLength": 4, "maxLength": 32 },
            "text": { "type": "string", "minLength": 4, "maxLength": 32 },
            "isDark": { "type": "boolean" }
          }
        },
        "soundcloudTrack": {
          "type": "object",
          "description": "Attached SoundCloud track metadata for the poem.",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "artist": { "type": "string", "minLength": 1, "maxLength": 140 },
            "soundcloudUrl": { "type": "string", "minLength": 10, "maxLength": 500 },
            "embedTargetUrl": { "type": "string", "minLength": 10, "maxLength": 500 },
            "artworkUrl": { "type": "string", "minLength": 0, "maxLength": 500 }
          }
        },
        "soundcloudTracks": {
          "type": "array",
          "description": "List of up to 10 attached SoundCloud tracks for the poem.",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "artist": { "type": "string", "minLength": 1, "maxLength": 140 },
              "soundcloudUrl": { "type": "string", "minLength": 10, "maxLength": 500 },
              "embedTargetUrl": { "type": "string", "minLength": 10, "maxLength": 500 },
              "artworkUrl": { "type": "string", "minLength": 0, "maxLength": 500 }
            }
          }
        },
        "isCommunity": { "type": "boolean" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorPhotoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "submissionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workStatus": { "type": "string", "enum": ["completed", "in_progress"] },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "cycle", "year", "excerpt", "content", "note", "order", "updatedAt"]
    },
