        "content": { "type": "string", "minLength": 0, "maxLength": 400000 },
        "cycle": { "type": "string", "minLength": 0, "maxLength": 160 },
        "year": { "type": "number" },
        "note": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "fontSize": { "type": "string", "minLength": 0, "maxLength": 10 },
        "textAlign": { "type": "string", "minLength": 0, "maxLength": 10 },
        "lineSpacing": { "type": "string", "minLength": 0, "maxLength": 10 },
        "textColor": { "type": "string", "minLength": 0, "maxLength": 32 },
        "backgroundColor": { "type": "string", "minLength": 0, "maxLength": 32 },
