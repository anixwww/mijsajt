  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Server-managed admin RBAC documents readable by owner or admin and non-writable by clients."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private user PII profiles restricted to owner or admin."
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicUserProfile" },
      "description": "Public non-PII user profiles for activity leaderboard, badges, likes, and time tracking."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reader comments and optional ratings for poems, prose, and store items."
    },
    "/workVotes/{voteId}": {
      "schema": { "$ref": "#/entities/WorkVote" },
      "description": "Per-user persisted ratings (0.1-5.0) for poems, prose, and store items."
    },
    "/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Global community chat messages."
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "Verified supporter donation entries for the donor leaderboard."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Persisted orders with encrypted buyer PII; reads restricted to owner/admin, writes strictly admin-only."
    },
    "/radioTracks/{trackId}": {
      "schema": { "$ref": "#/entities/RadioTrack" },
      "description": "Persisted SoundCloud radio playlist tracks readable by authenticated users and managed by admin."
    },
    "/radioLikes/{likeId}": {
      "schema": { "$ref": "#/entities/RadioLike" },
      "description": "Per-user radio track like markers readable publicly for accurate counts and writable only by the authenticated owner."
    },
    "/monthlySelections/{selectionId}": {
      "schema": { "$ref": "#/entities/MonthlySelection" },
      "description": "Curated monthly SoundCloud track selections publicly readable and managed by admin."
    },
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Persisted site home settings, author bio/photos, social links, interviews, prose tags, and discounts."
    },
    "/poems/{poemId}": {
      "schema": { "$ref": "#/entities/Poem" },
      "description": "Persisted poems collection."
    },
    "/prose/{proseId}": {
      "schema": { "$ref": "#/entities/ProseWork" },
      "description": "Persisted prose works catalog and public prose content."
    },
    "/prosePrivate/{proseId}": {
      "schema": { "$ref": "#/entities/ProsePrivate" },
      "description": "Protected prose full texts and chapters for authorized or paid works."
    },
    "/blogPosts/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Persisted blog posts collection."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/StoreProduct" },
      "description": "Persisted storefront products catalog."
    },
    "/productSecrets/{productId}": {
      "schema": { "$ref": "#/entities/ProductSecret" },
      "description": "Protected storefront product digital content and Google Docs links."
    },
    "/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Persisted uploaded cover/author images served across redeploys."
    },
    "/adminSecrets/{secretId}": {
      "schema": { "$ref": "#/entities/AdminSecret" },
      "description": "Admin-only integration secrets such as Telegram bot token."
    },
    "/poemLikes/{likeId}": {
      "schema": { "$ref": "#/entities/PoemLike" },
      "description": "Per-user poem like markers readable publicly for accurate counts and writable only by the authenticated owner."
    },
    "/poemSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/PoemSubmission" },
      "description": "Reader-proposed poems waiting for or processed by admin moderation."
    },
    "/proseSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ProseSubmission" },
      "description": "Reader-proposed prose works waiting for or processed by admin moderation."
    },
    "/siteFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/SiteFeedback" },
      "description": "Website feedback submitted by visitors/users with direct inline admin replies and cross-device sync."
    },
    "/weeklyHighlights/{highlightId}": {
      "schema": { "$ref": "#/entities/WeeklyHighlight" },
