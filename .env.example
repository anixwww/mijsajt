# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYMENT_ENCRYPTION_KEY: Secret key (32+ chars) for server-side AES-256-GCM encryption
# of customer order PII at rest and HMAC-SHA256 receipt integrity verification.
PAYMENT_ENCRYPTION_KEY="MY_PAYMENT_ENCRYPTION_KEY"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather (bot must be an admin of your channel)
# used to verify channel subscriptions via Telegram Bot API getChatMember.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHANNEL_ID: Optional @channelusername or numeric -100... chat ID.
# If omitted, defaults to the Telegram link configured in Author Studio.
TELEGRAM_CHANNEL_ID=""

# TELEGRAM_WEBHOOK_SECRET: Optional secret token for Telegram webhook verification.
TELEGRAM_WEBHOOK_SECRET=""

# MONOBANK_TOKEN: Optional Monobank Acquiring X-Token for live monobank prose invoices.
MONOBANK_TOKEN=""

# VITE_FIREBASE_AUTH_BRIDGE_URL: Optional URL of a permanently authorized domain
# hosting /google-auth-bridge.html (e.g. https://awesome-ripsaw-nlxdt.web.app/google-auth-bridge.html)
# to bypass Firebase auth/unauthorized-domain across temporary AI Studio preview URLs.
VITE_FIREBASE_AUTH_BRIDGE_URL=""

# GUEST_SESSION_SECRET: Optional secret for signing guest session tokens.
GUEST_SESSION_SECRET=""

# VITE_AUTH_BRIDGE_ALLOWED_ORIGINS: Optional comma-separated allowed origins for the Google auth bridge.
VITE_AUTH_BRIDGE_ALLOWED_ORIGINS=""

# VITE_FIREBASE_VAPID_KEY: Optional Firebase Web Push VAPID key for browser notifications.
VITE_FIREBASE_VAPID_KEY=""

# ADMIN_EMAILS: Comma-separated list of admin email addresses authorized for content editing.
ADMIN_EMAILS="admin@example.com"

# ADMIN_CONTACT_EMAIL: Public contact email displayed in site settings.
ADMIN_CONTACT_EMAIL="contact@example.com"

