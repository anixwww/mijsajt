# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_KEY: Optional secret passphrase for author (andrijdankiv5@gmail.com)
# login & device pairing when signing in on authorized preview/production domains.
ADMIN_ACCESS_KEY=""

# ADMIN_ALLOWED_DOMAINS: Optional comma-separated hostnames allowed for author access
# (in addition to APP_URL, its preview/dev pair, and localhost).
ADMIN_ALLOWED_DOMAINS=""

# AUTHOR_SESSION_SECRET: Optional HMAC signing secret for domain/device author sessions.
AUTHOR_SESSION_SECRET=""

