            isOwner(existing().authorUid)
            && existing().status == 'pending'
            && incoming().status == 'pending'
            && !('moderationNote' in incoming())
            && !('publishedProseId' in incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'authorPhotoUrl', 'title', 'genre', 'slogan', 'excerpt',
              'content', 'pages', 'totalWords', 'moodboardUrls', 'workStatus', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(submissionId) && isAdmin();
    }

    match /adminSecrets/{secretId} {
      allow get: if isSignedIn() && isValidId(secretId) && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn()
        && isValidId(secretId)
        && isValidAdminSecret(incoming(), secretId)
        && isAdmin()
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(secretId)
        && isValidAdminSecret(incoming(), secretId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['telegramBotToken', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(secretId) && isAdmin();
    }

    match /monthlySelections/{selectionId} {
      allow get: if isValidId(selectionId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidId(selectionId)
        && isValidMonthlySelection(incoming(), selectionId)
        && isAdmin()
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(selectionId)
        && isValidMonthlySelection(incoming(), selectionId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'monthKey', 'title', 'description', 'tracks', 'order', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(selectionId) && isAdmin();
    }

    match /siteFeedback/{feedbackId} {
      allow get: if isSignedIn()
        && isValidId(feedbackId)
        && (isAdmin() || ('authorUid' in existing() && existing().authorUid == request.auth.uid));
      allow list: if isSignedIn()
        && (isAdmin() || ('authorUid' in resource.data && resource.data.authorUid == request.auth.uid));
      allow create: if isSignedIn()
        && isValidId(feedbackId)
        && isValidSiteFeedback(incoming(), feedbackId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            'authorUid' in incoming()
            && incoming().authorUid == request.auth.uid
            && incoming().readByAdmin == false
            && incoming().readByUser == true
            && !('adminReply' in incoming())
            && !('adminReplyAt' in incoming())
            && !('adminReplyAuthorName' in incoming())
          )
        );
      allow update: if isSignedIn()
        && isValidId(feedbackId)
        && isValidSiteFeedback(incoming(), feedbackId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (!('authorUid' in existing()) && !('authorUid' in incoming()))
          || ('authorUid' in existing() && 'authorUid' in incoming() && incoming().authorUid == existing().authorUid)
        )
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'readByAdmin', 'readByUser', 'adminReply', 'adminReplyAt', 'adminReplyAuthorName', 'updatedAt'
            ])
          )
          || (
            'authorUid' in existing()
            && isOwner(existing().authorUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['readByUser', 'updatedAt'])
            && incoming().readByUser == true
          )
        );
      allow delete: if isSignedIn() && isValidId(feedbackId) && isAdmin();
    }

    match /weeklyHighlights/{highlightId} {
      allow get: if isValidId(highlightId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidId(highlightId)
        && isValidWeeklyHighlight(incoming(), highlightId)
        && isAdmin()
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(highlightId)
        && isValidWeeklyHighlight(incoming(), highlightId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().targetType == existing().targetType
        && incoming().weekKey == existing().weekKey
        && incoming().periodStart == existing().periodStart
        && incoming().periodEnd == existing().periodEnd
        && incoming().selectedAt == existing().selectedAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'periodLabel', 'sourcePoemId', 'sourceProseId', 'sourceSubmissionId',
          'authorUid', 'authorName', 'authorPhotoUrl', 'title', 'content',
          'cycle', 'year', 'note', 'fontSize', 'textAlign', 'lineSpacing',
          'textColor', 'backgroundColor', 'imageUrl', 'imagePalette',
          'soundcloudTrack', 'soundcloudTracks', 'genre', 'pages', 'totalWords',
          'slogan', 'chapters', 'moodboardUrls', 'publishedAt',
          'ratingAverage', 'ratingCount', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(highlightId) && isAdmin();
    }

    match /weeklyMusicSelections/{selectionId} {
      allow get: if isValidId(selectionId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidId(selectionId)
        && isValidWeeklyMusicSelection(incoming(), selectionId)
        && isAdmin()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(selectionId)
        && isValidWeeklyMusicSelection(incoming(), selectionId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'weekKey', 'periodStart', 'periodEnd', 'periodLabel', 'text', 'photos', 'tracks', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(selectionId) && isAdmin();
    }
  }
}
