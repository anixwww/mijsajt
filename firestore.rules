    function isValidWeeklyMusicSelection(data, selectionId) {
      return data.keys().hasAll([
          'id', 'weekKey', 'periodStart', 'periodEnd', 'periodLabel',
          'photos', 'tracks', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'weekKey', 'periodStart', 'periodEnd', 'periodLabel',
          'text', 'photos', 'tracks', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == selectionId && isValidId(data.id)
        && data.weekKey is string && data.weekKey.size() >= 7 && data.weekKey.size() <= 10 && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && data.periodStart is string && data.periodStart.size() == 10 && data.periodStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.periodEnd is string && data.periodEnd.size() == 10 && data.periodEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 120
        && (!('text' in data) || (data.text is string && data.text.size() <= 5000))
        && data.photos is list && data.photos.size() <= 12
        && (data.photos.size() == 0 || (data.photos[0] is string && data.photos[0].size() <= 1000))
        && data.tracks is list && data.tracks.size() <= 50
        && (data.tracks.size() == 0 || isValidSoundCloudTrackMap(data.tracks[0]))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /test/connection {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserPrivateProfile(incoming(), userId)
        && (!('uid' in existing()) || incoming().uid == existing().uid)
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'uid', 'displayName', 'email', 'likedPoemIds', 'likedRadioTrackIds',
          'donorChatText', 'totalTimeSeconds', 'lastSeenAt', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidPublicProfile(incoming(), userId)
        && (!('purchasesCount' in incoming()) || isAdmin() || incoming().purchasesCount <= 25)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!('purchasesCount' in incoming()) || isAdmin() || !('purchasesCount' in existing()) || (incoming().purchasesCount >= existing().purchasesCount && incoming().purchasesCount <= existing().purchasesCount + 25))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'guestUid', 'displayName', 'photoUrl', 'likedPoemIds',
          'likedRadioTrackIds', 'totalTimeSeconds', 'purchasesCount',
          'donorChatText', 'lastSeenAt', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /poemLikes/{likeId} {
