rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'andrijdankiv5@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll(['id', 'targetType', 'targetId', 'authorUid', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'targetType', 'targetId', 'authorUid', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.id is string && data.id == reviewId && isValidId(data.id)
        && data.targetType is string && (data.targetType == 'poem' || data.targetType == 'product')
        && data.targetId is string && isValidId(data.targetId)
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.rating is number && data.rating >= 0.1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 0 && data.comment.size() <= 1500
        && data.createdAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId)
        && isSignedIn()
        && isValidReview(incoming(), reviewId)
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(reviewId)
        && (isOwner(existing().authorUid) || isAdmin())
        && isValidReview(incoming(), reviewId)
        && incoming().id == existing().id
        && incoming().targetType == existing().targetType
        && incoming().targetId == existing().targetId
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']);
      allow delete: if isValidId(reviewId) && (isOwner(existing().authorUid) || isAdmin());
    }
  }
}
