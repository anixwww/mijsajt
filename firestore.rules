rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCompositeId(id) {
      return id is string && id.size() >= 3 && id.size() <= 300 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email is string && (
          request.auth.token.email.lower() == 'andrijdankiv5@gmail.com' ||
          request.auth.token.email.lower() == 'andriidankiv.writer@gmail.com'
        ))
      );
    }

    function isSafeHttpUrl(val, maxLen) {
      return val is string && val.size() >= 10 && val.size() <= maxLen && val.matches('^https?://.+');
    }

    function isSafeHttpUrlOrEmpty(val, maxLen) {
      return val is string && val.size() <= maxLen && (val.size() == 0 || val.matches('^https?://.+'));
    }

    function isSafeMediaUrlOrEmpty(val, maxLen) {
      return val is string && val.size() <= maxLen && (
        val.size() == 0 ||
        val.matches('^https?://.+') ||
        val.matches('^/(uploads|src/assets)/.+') ||
        val.matches('^data:image/(png|jpeg|jpg|webp|gif|avif);base64,.+')
      );
    }

    function isValidImagePalette(palette) {
      return palette is map
        && palette.keys().hasAll(['background', 'text'])
        && palette.keys().hasOnly(['background', 'secondaryBackground', 'text', 'isDark'])
        && palette.background is string && palette.background.size() >= 4 && palette.background.size() <= 32
        && palette.text is string && palette.text.size() >= 4 && palette.text.size() <= 32
        && (!('secondaryBackground' in palette) || (palette.secondaryBackground is string && palette.secondaryBackground.size() >= 4 && palette.secondaryBackground.size() <= 32))
        && (!('isDark' in palette) || palette.isDark is bool);
    }

    function isValidSoundCloudTrackMap(track) {
      return track is map
        && track.keys().hasAll(['id', 'title', 'artist', 'soundcloudUrl', 'embedTargetUrl'])
        && track.keys().hasOnly(['id', 'title', 'artist', 'soundcloudUrl', 'embedTargetUrl', 'artworkUrl'])
        && track.id is string && track.id.size() >= 1 && track.id.size() <= 128
        && track.title is string && track.title.size() >= 1 && track.title.size() <= 200
        && track.artist is string && track.artist.size() >= 1 && track.artist.size() <= 140
        && isSafeHttpUrl(track.soundcloudUrl, 500)
        && isSafeHttpUrl(track.embedTargetUrl, 500)
        && (!('artworkUrl' in track) || isSafeMediaUrlOrEmpty(track.artworkUrl, 500));
    }

    function isValidMonthlySelectionTrackMap(track) {
      return track is map
        && track.keys().hasAll(['id', 'title', 'artist', 'soundcloudUrl', 'embedTargetUrl', 'addedAt'])
        && track.keys().hasOnly(['id', 'title', 'artist', 'soundcloudUrl', 'embedTargetUrl', 'artworkUrl', 'note', 'addedAt'])
        && track.id is string && track.id.size() >= 1 && track.id.size() <= 128
        && track.title is string && track.title.size() >= 1 && track.title.size() <= 200
        && track.artist is string && track.artist.size() >= 1 && track.artist.size() <= 140
        && isSafeHttpUrl(track.soundcloudUrl, 500)
        && isSafeHttpUrl(track.embedTargetUrl, 500)
        && (!('artworkUrl' in track) || isSafeMediaUrlOrEmpty(track.artworkUrl, 500))
        && (!('note' in track) || (track.note is string && track.note.size() <= 500))
        && track.addedAt is string && track.addedAt.size() >= 10 && track.addedAt.size() <= 64;
    }

    function isValidProseChapterMap(ch) {
      return ch is map
        && ch.keys().hasAll(['id', 'title', 'content', 'publishedAt'])
        && ch.keys().hasOnly(['id', 'title', 'content', 'publishedAt'])
        && ch.id is string && ch.id.size() >= 1 && ch.id.size() <= 128
        && ch.title is string && ch.title.size() <= 240
        && ch.content is string && ch.content.size() <= 400000
        && ch.publishedAt is string && ch.publishedAt.size() <= 120;
    }

    function isValidSocialLinkMap(item) {
      return item is map
        && item.keys().hasAll(['platform', 'label', 'url', 'enabled'])
        && item.keys().hasOnly(['platform', 'label', 'url', 'enabled'])
        && item.platform is string
        && (item.platform == 'telegram' || item.platform == 'instagram' || item.platform == 'facebook' || item.platform == 'youtube' || item.platform == 'threads' || item.platform == 'x' || item.platform == 'tiktok')
        && item.label is string && item.label.size() <= 80
        && isSafeHttpUrlOrEmpty(item.url, 500)
        && item.enabled is bool;
    }

    function isValidInterviewMap(item) {
      return item is map
        && item.keys().hasAll(['id', 'title', 'outlet', 'dateLabel'])
        && item.keys().hasOnly(['id', 'title', 'outlet', 'dateLabel', 'content', 'url'])
        && item.id is string && item.id.size() >= 1 && item.id.size() <= 128
        && item.title is string && item.title.size() >= 1 && item.title.size() <= 240
        && item.outlet is string && item.outlet.size() <= 160
        && item.dateLabel is string && item.dateLabel.size() <= 80
        && (!('content' in item) || (item.content is string && item.content.size() <= 50000))
        && (!('url' in item) || isSafeHttpUrlOrEmpty(item.url, 1000));
    }

    function isValidProseTagMap(item) {
      return item is map
        && item.keys().hasAll(['id', 'label', 'color'])
        && item.keys().hasOnly(['id', 'label', 'color'])
        && item.id is string && item.id.size() >= 1 && item.id.size() <= 128
        && item.label is string && item.label.size() >= 1 && item.label.size() <= 80
        && item.color is string && item.color.size() >= 1 && item.color.size() <= 32;
    }

    function isValidOrderItemMap(item) {
      return item is map
        && item.keys().hasAll(['productId', 'orderCode', 'title', 'type', 'purchasedAt'])
        && item.keys().hasOnly([
          'productId', 'orderCode', 'title', 'type', 'proseId', 'purchasedAt',
          'gdocGuestUrl', 'downloadUrl', 'ebookFileName', 'ebookFileSize',
          'pdfFileName', 'pdfFileSize', 'hasPdf', 'formats', 'progressLabel',
          'shippingSummary', 'paymentTransactionId'
        ])
        && item.productId is string && isValidId(item.productId)
        && item.orderCode is string && isValidId(item.orderCode)
        && item.title is string && item.title.size() >= 1 && item.title.size() <= 240
        && item.type is string && (
          item.type == 'paper_book' || item.type == 'ebook' || item.type == 'wip_gdoc' ||
          item.type == 'poem_frame' || item.type == 'painting' || item.type == 'prose_access'
        )
        && (!('proseId' in item) || (item.proseId is string && isValidId(item.proseId)))
        && item.purchasedAt is string && item.purchasedAt.size() >= 1 && item.purchasedAt.size() <= 64
        && (!('gdocGuestUrl' in item) || isSafeHttpUrlOrEmpty(item.gdocGuestUrl, 1000))
        && (!('downloadUrl' in item) || (item.downloadUrl is string && item.downloadUrl.size() <= 500))
        && (!('ebookFileName' in item) || (item.ebookFileName is string && item.ebookFileName.size() <= 250))
        && (!('ebookFileSize' in item) || (item.ebookFileSize is number && item.ebookFileSize >= 0 && item.ebookFileSize <= 200000000))
        && (!('pdfFileName' in item) || (item.pdfFileName is string && item.pdfFileName.size() <= 250))
        && (!('pdfFileSize' in item) || (item.pdfFileSize is number && item.pdfFileSize >= 0 && item.pdfFileSize <= 200000000))
        && (!('hasPdf' in item) || item.hasPdf is bool)
        && (!('formats' in item) || (item.formats is string && item.formats.size() <= 200))
        && (!('progressLabel' in item) || (item.progressLabel is string && item.progressLabel.size() <= 200))
        && (!('shippingSummary' in item) || (item.shippingSummary is string && item.shippingSummary.size() <= 300))
        && (!('paymentTransactionId' in item) || (item.paymentTransactionId is string && item.paymentTransactionId.size() <= 128));
    }

    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'likedPoemIds', 'likedRadioTrackIds',
          'donorChatText', 'totalTimeSeconds', 'lastSeenAt', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('likedPoemIds' in data) || (data.likedPoemIds is list && data.likedPoemIds.size() <= 500 && (data.likedPoemIds.size() == 0 || isValidId(data.likedPoemIds[0]))))
        && (!('likedRadioTrackIds' in data) || (data.likedRadioTrackIds is list && data.likedRadioTrackIds.size() <= 500 && (data.likedRadioTrackIds.size() == 0 || isValidId(data.likedRadioTrackIds[0]))))
        && (!('donorChatText' in data) || (data.donorChatText is string && data.donorChatText.size() <= 120))
        && (!('totalTimeSeconds' in data) || (data.totalTimeSeconds is number && data.totalTimeSeconds >= 0 && data.totalTimeSeconds <= 100000000))
        && (!('lastSeenAt' in data) || (data.lastSeenAt is string && data.lastSeenAt.size() <= 64))
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && data.createdAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'guestUid', 'displayName', 'photoUrl', 'likedPoemIds',
          'likedRadioTrackIds', 'totalTimeSeconds', 'purchasesCount',
          'donorChatText', 'lastSeenAt', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && (!('guestUid' in data) || (data.guestUid is string && isValidId(data.guestUid)))
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoUrl' in data) || isSafeMediaUrlOrEmpty(data.photoUrl, 500))
        && (!('likedPoemIds' in data) || (data.likedPoemIds is list && data.likedPoemIds.size() <= 500 && (data.likedPoemIds.size() == 0 || isValidId(data.likedPoemIds[0]))))
        && (!('likedRadioTrackIds' in data) || (data.likedRadioTrackIds is list && data.likedRadioTrackIds.size() <= 500 && (data.likedRadioTrackIds.size() == 0 || isValidId(data.likedRadioTrackIds[0]))))
        && (!('totalTimeSeconds' in data) || (data.totalTimeSeconds is number && data.totalTimeSeconds >= 0 && data.totalTimeSeconds <= 100000000))
        && (!('purchasesCount' in data) || (data.purchasesCount is number && data.purchasesCount >= 0 && data.purchasesCount <= 10000))
        && (!('donorChatText' in data) || (data.donorChatText is string && data.donorChatText.size() <= 80))
        && (!('lastSeenAt' in data) || (data.lastSeenAt is string && data.lastSeenAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll(['id', 'targetType', 'targetId', 'authorUid', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'targetType', 'targetId', 'authorUid', 'authorName', 'authorPhotoUrl', 'rating', 'comment', 'createdAt'])
        && data.id is string && data.id == reviewId && isValidId(data.id)
        && data.targetType is string && (data.targetType == 'poem' || data.targetType == 'prose' || data.targetType == 'product')
        && data.targetId is string && isValidId(data.targetId)
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && (!('authorPhotoUrl' in data) || isSafeMediaUrlOrEmpty(data.authorPhotoUrl, 500))
        && (data.rating == null || (data.rating is number && data.rating >= 0.1 && data.rating <= 5))
        && data.comment is string && data.comment.size() >= 0 && data.comment.size() <= 1500
        && (data.comment.size() > 0 || (data.rating is number && data.rating >= 0.1 && data.rating <= 5))
        && data.createdAt is timestamp;
    }

    function isValidWorkVote(data, voteId) {
      return data.keys().hasAll(['id', 'targetType', 'targetId', 'userId', 'rating', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'targetType', 'targetId', 'userId', 'rating', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == voteId && isValidCompositeId(data.id)
        && data.targetType is string && (data.targetType == 'poem' || data.targetType == 'prose' || data.targetType == 'product')
        && data.targetId is string && isValidId(data.targetId)
        && data.userId is string && isValidId(data.userId)
        && data.rating is number && data.rating >= 0.1 && data.rating <= 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, messageId) {
      return data.keys().hasAll(['id', 'authorUid', 'authorName', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'authorUid', 'authorName', 'authorPhotoUrl', 'isAdmin', 'text', 'replyTo', 'createdAt'])
        && data.id is string && data.id == messageId && isValidId(data.id)
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && (!('authorPhotoUrl' in data) || isSafeMediaUrlOrEmpty(data.authorPhotoUrl, 500))
        && (!('isAdmin' in data) || data.isAdmin is bool)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 600
        && (!('replyTo' in data) || (
          data.replyTo is map
          && data.replyTo.keys().hasAll(['id', 'authorUid', 'authorName', 'text'])
          && data.replyTo.keys().hasOnly(['id', 'authorUid', 'authorName', 'text'])
          && data.replyTo.id is string && isValidId(data.replyTo.id)
          && data.replyTo.authorUid is string && isValidId(data.replyTo.authorUid)
          && data.replyTo.authorName is string && data.replyTo.authorName.size() >= 1 && data.replyTo.authorName.size() <= 80
          && data.replyTo.text is string && data.replyTo.text.size() >= 1 && data.replyTo.text.size() <= 180
        ))
        && data.createdAt is timestamp;
    }

    function isValidDonation(data, donationId) {
      return data.keys().hasAll(['id', 'displayName', 'amountUah', 'donatedAt', 'createdAt'])
        && data.keys().hasOnly(['id', 'guestUid', 'displayName', 'photoUrl', 'amountUah', 'note', 'donatedAt', 'createdAt'])
        && data.id is string && data.id == donationId && isValidId(data.id)
        && (!('guestUid' in data) || (data.guestUid is string && isValidId(data.guestUid)))
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoUrl' in data) || isSafeMediaUrlOrEmpty(data.photoUrl, 500))
        && data.amountUah is number && data.amountUah >= 1 && data.amountUah <= 10000000
        && (!('note' in data) || (data.note is string && data.note.size() <= 200))
        && data.donatedAt is string && data.donatedAt.size() >= 1 && data.donatedAt.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll(['orderCode', 'buyerName', 'buyerEmail', 'totalUah', 'items', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'orderCode', 'guestUid', 'buyerName', 'buyerEmail',
          'buyerNameMasked', 'buyerEmailMasked', 'buyerEmailHash',
          'encryptedPii', 'integrityVerified', 'piiLocked',
          'totalUah', 'payment', 'items', 'createdAt', 'updatedAt'
        ])
        && (!('id' in data) || (data.id is string && data.id == orderId && isValidId(data.id)))
        && data.orderCode is string && data.orderCode == orderId && isValidId(data.orderCode)
        && (!('guestUid' in data) || (data.guestUid is string && isValidId(data.guestUid)))
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 120
        && data.buyerEmail is string && data.buyerEmail.size() >= 3 && data.buyerEmail.size() <= 254
        && (!('buyerNameMasked' in data) || (data.buyerNameMasked is string && data.buyerNameMasked.size() <= 120))
        && (!('buyerEmailMasked' in data) || (data.buyerEmailMasked is string && data.buyerEmailMasked.size() <= 254))
        && (!('buyerEmailHash' in data) || (data.buyerEmailHash is string && data.buyerEmailHash.size() <= 128))
        && (!('encryptedPii' in data) || (
          data.encryptedPii is map
          && data.encryptedPii.keys().hasAll(['alg', 'iv', 'tag', 'ciphertext'])
          && data.encryptedPii.keys().hasOnly(['alg', 'iv', 'tag', 'ciphertext'])
          && data.encryptedPii.alg is string && data.encryptedPii.alg.size() <= 32
          && data.encryptedPii.iv is string && data.encryptedPii.iv.size() <= 128
          && data.encryptedPii.tag is string && data.encryptedPii.tag.size() <= 128
          && data.encryptedPii.ciphertext is string && data.encryptedPii.ciphertext.size() <= 20000
        ))
        && (!('integrityVerified' in data) || data.integrityVerified is bool)
        && (!('piiLocked' in data) || data.piiLocked is bool)
        && data.totalUah is number && data.totalUah >= 0 && data.totalUah <= 10000000
        && (!('payment' in data) || (
          data.payment is map
          && data.payment.keys().hasAll(['status', 'providerLabel', 'method', 'transactionId', 'paidAt'])
          && data.payment.keys().hasOnly([
            'status', 'providerLabel', 'method', 'cardBrand', 'cardLast4',
            'cardFingerprint', 'encryptionProtocol', 'receiptSignature', 'transactionId', 'paidAt'
          ])
          && data.payment.status is string && data.payment.status == 'paid'
          && data.payment.providerLabel is string && data.payment.providerLabel.size() <= 120
          && data.payment.method is string && (data.payment.method == 'card' || data.payment.method == 'apple_google_pay' || data.payment.method == 'monobank')
          && (!('cardBrand' in data.payment) || (data.payment.cardBrand is string && data.payment.cardBrand.size() <= 40))
          && (!('cardLast4' in data.payment) || (data.payment.cardLast4 is string && data.payment.cardLast4.size() <= 8))
          && (!('cardFingerprint' in data.payment) || (data.payment.cardFingerprint is string && data.payment.cardFingerprint.size() <= 128))
          && (!('encryptionProtocol' in data.payment) || (data.payment.encryptionProtocol is string && data.payment.encryptionProtocol.size() <= 120))
          && (!('receiptSignature' in data.payment) || (data.payment.receiptSignature is string && data.payment.receiptSignature.size() <= 256))
          && data.payment.transactionId is string && data.payment.transactionId.size() <= 128
          && data.payment.paidAt is string && data.payment.paidAt.size() <= 64
        ))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && isValidOrderItemMap(data.items[0])
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidRadioTrack(data, trackId) {
      return data.keys().hasAll(['id', 'title', 'artist', 'soundcloudUrl', 'embedTargetUrl', 'artworkUrl', 'station', 'order', 'visibility', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'artist', 'soundcloudUrl', 'embedTargetUrl', 'artworkUrl', 'station', 'order', 'visibility', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == trackId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 140
        && isSafeHttpUrl(data.soundcloudUrl, 500)
        && isSafeHttpUrl(data.embedTargetUrl, 500)
        && isSafeMediaUrlOrEmpty(data.artworkUrl, 500)
        && data.station is string && (data.station == 'indie' || data.station == 'electronic')
        && data.order is number && data.order >= 0 && data.order <= 100000
        && data.visibility is string && data.visibility == 'authenticated'
        && data.createdByUid is string && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data, configId) {
      return data.keys().hasAll([
          'id', 'heroLeadText', 'authorAboutText', 'authorPhotoUrl', 'authorPhotos',
          'socialLinks', 'monobankJarUrl', 'contactEmail', 'interviews',
          'homeActionAboutTitle', 'homeActionContactTitle', 'homeActionMonobankTitle',
          'homeActionInterviewsTitle', 'proseAuthDiscountPercent', 'storeAuthDiscountPercent',
          'proseTags', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'heroLeadText', 'authorAboutText', 'authorPhotoUrl', 'authorPhotos',
          'socialLinks', 'monobankJarUrl', 'monobankModalTitle', 'monobankModalSubtitle',
          'monobankCardLabel', 'monobankModalText', 'monobankEmptyText', 'contactEmail', 'interviews',
          'homeActionAboutTitle', 'homeActionContactTitle', 'homeActionMonobankTitle',
          'homeActionInterviewsTitle', 'homeRepeaters', 'proseAuthDiscountPercent', 'proseTelegramDiscountPercent',
          'telegramChannelId', 'storeAuthDiscountPercent', 'proseTags', 'updatedAt'
        ])
        && data.id is string && data.id == configId && isValidId(data.id)
        && data.heroLeadText is string && data.heroLeadText.size() <= 2000
        && data.authorAboutText is string && data.authorAboutText.size() <= 10000
        && isSafeMediaUrlOrEmpty(data.authorPhotoUrl, 500)
        && data.authorPhotos is list && data.authorPhotos.size() <= 20
        && (data.authorPhotos.size() == 0 || isSafeMediaUrlOrEmpty(data.authorPhotos[0], 500))
        && data.socialLinks is list && data.socialLinks.size() <= 20
        && (data.socialLinks.size() == 0 || isValidSocialLinkMap(data.socialLinks[0]))
        && isSafeHttpUrlOrEmpty(data.monobankJarUrl, 500)
        && (!('monobankModalTitle' in data) || (data.monobankModalTitle is string && data.monobankModalTitle.size() <= 120))
        && (!('monobankModalSubtitle' in data) || (data.monobankModalSubtitle is string && data.monobankModalSubtitle.size() <= 300))
        && (!('monobankCardLabel' in data) || (data.monobankCardLabel is string && data.monobankCardLabel.size() <= 80))
        && (!('monobankModalText' in data) || (data.monobankModalText is string && data.monobankModalText.size() <= 1500))
        && (!('monobankEmptyText' in data) || (data.monobankEmptyText is string && data.monobankEmptyText.size() <= 1000))
        && data.contactEmail is string && data.contactEmail.size() <= 254
        && data.interviews is list && data.interviews.size() <= 50
        && (data.interviews.size() == 0 || isValidInterviewMap(data.interviews[0]))
        && data.homeActionAboutTitle is string && data.homeActionAboutTitle.size() <= 120
        && data.homeActionContactTitle is string && data.homeActionContactTitle.size() <= 120
        && data.homeActionMonobankTitle is string && data.homeActionMonobankTitle.size() <= 120
        && data.homeActionInterviewsTitle is string && data.homeActionInterviewsTitle.size() <= 120
        && (!('homeRepeaters' in data) || (
          data.homeRepeaters is map
          && data.homeRepeaters.keys().hasAll(['poemMode', 'poemLimit', 'proseMode', 'proseLimit', 'blogMode', 'blogLimit', 'storeMode', 'storeLimit'])
          && data.homeRepeaters.keys().hasOnly(['poemMode', 'poemLimit', 'proseMode', 'proseLimit', 'blogMode', 'blogLimit', 'storeMode', 'storeLimit'])
          && data.homeRepeaters.poemMode is string && (data.homeRepeaters.poemMode == 'latest' || data.homeRepeaters.poemMode == 'top_rated' || data.homeRepeaters.poemMode == 'most_liked' || data.homeRepeaters.poemMode == 'most_viewed')
          && data.homeRepeaters.poemLimit is number && data.homeRepeaters.poemLimit >= 1 && data.homeRepeaters.poemLimit <= 12
          && data.homeRepeaters.proseMode is string && (data.homeRepeaters.proseMode == 'latest' || data.homeRepeaters.proseMode == 'top_rated' || data.homeRepeaters.proseMode == 'free_only' || data.homeRepeaters.proseMode == 'paid_only')
          && data.homeRepeaters.proseLimit is number && data.homeRepeaters.proseLimit >= 1 && data.homeRepeaters.proseLimit <= 12
