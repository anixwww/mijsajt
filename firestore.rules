    match /poemSubmissions/{submissionId} {
      allow get: if isValidId(submissionId)
        && (isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid));
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isValidId(submissionId)
        && isSignedIn()
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'pending'
        && !('moderationNote' in incoming())
        && !('publishedPoemId' in incoming())
        && isValidPoemSubmission(incoming(), submissionId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId)
        && isValidPoemSubmission(incoming(), submissionId)
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(existing().authorUid)
            && incoming().status == 'pending'
            && !('moderationNote' in incoming())
            && (
              (!('publishedPoemId' in existing()) && !('publishedPoemId' in incoming()))
              || ('publishedPoemId' in existing() && 'publishedPoemId' in incoming() && incoming().publishedPoemId == existing().publishedPoemId)
            )
          )
        );
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    match /proseSubmissions/{submissionId} {
