        && (!('lineSpacing' in data) || (data.lineSpacing is string && data.lineSpacing.size() <= 10))
        && (!('textColor' in data) || (data.textColor is string && data.textColor.size() <= 32))
        && (!('backgroundColor' in data) || (data.backgroundColor is string && data.backgroundColor.size() <= 32))
        && (!('imageUrl' in data) || isSafeMediaUrlOrEmpty(data.imageUrl, 1000))
        && (!('imagePalette' in data) || isValidImagePalette(data.imagePalette))
        && (!('soundcloudTrack' in data) || isValidSoundCloudTrackMap(data.soundcloudTrack))
        && (!('soundcloudTracks' in data) || (
          data.soundcloudTracks is list
          && data.soundcloudTracks.size() <= 10
          && (data.soundcloudTracks.size() == 0 || isValidSoundCloudTrackMap(data.soundcloudTracks[0]))
        ))
        && (!('genre' in data) || (data.genre is string && data.genre.size() <= 120))
        && (!('pages' in data) || (data.pages is number && data.pages >= 1 && data.pages <= 50000))
        && (!('totalWords' in data) || (data.totalWords is number && data.totalWords >= 0 && data.totalWords <= 500000))
        && (!('slogan' in data) || (data.slogan is string && data.slogan.size() <= 500))
        && (!('chapters' in data) || (
          data.chapters is list
          && data.chapters.size() <= 200
          && (data.chapters.size() == 0 || isValidProseChapterMap(data.chapters[0]))
        ))
        && (!('moodboardUrls' in data) || (
          data.moodboardUrls is list
          && data.moodboardUrls.size() <= 20
          && (data.moodboardUrls.size() == 0 || isSafeMediaUrlOrEmpty(data.moodboardUrls[0], 1000))
        ))
        && (!('publishedAt' in data) || (data.publishedAt is string && data.publishedAt.size() <= 120))
        && data.ratingAverage is number && data.ratingAverage >= 0 && data.ratingAverage <= 5
        && data.ratingCount is number && data.ratingCount >= 0 && data.ratingCount <= 10000000
        && data.updatedAt is timestamp;
    }

    function isValidWeeklyMusicSelection(data, selectionId) {
      return data.keys().hasAll([
          'id', 'weekKey', 'periodStart', 'periodEnd', 'periodLabel',
          'photos', 'tracks', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'weekKey', 'periodStart', 'periodEnd', 'periodLabel',
          'text', 'photos', 'tracks', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == selectionId && isValidId(data.id)
        && data.weekKey is string && data.weekKey.size() >= 7 && data.weekKey.size() <= 10 && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && data.periodStart is string && data.periodStart.size() == 10 && data.periodStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.periodEnd is string && data.periodEnd.size() == 10 && data.periodEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 120
        && (!('text' in data) || (data.text is string && data.text.size() <= 5000))
        && data.photos is list && data.photos.size() <= 12
        && (data.photos.size() == 0 || isSafeMediaUrlOrEmpty(data.photos[0], 1000))
        && data.tracks is list && data.tracks.size() <= 50
        && (data.tracks.size() == 0 || isValidSoundCloudTrackMap(data.tracks[0]))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /test/connection {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        && (
          isAdmin()
          || (
            !('donorChatText' in incoming())
            && (!('totalTimeSeconds' in incoming()) || incoming().totalTimeSeconds == 0)
            && (!(request.auth.token.email is string) || incoming().email.lower() == request.auth.token.email.lower())
          )
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserPrivateProfile(incoming(), userId)
        && 'uid' in existing() && incoming().uid == existing().uid
        && 'createdAt' in existing() && incoming().createdAt == existing().createdAt
        && 'updatedAt' in incoming() && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'likedPoemIds', 'likedRadioTrackIds',
              'donorChatText', 'totalTimeSeconds', 'lastSeenAt', 'updatedAt'
            ])
          )
          || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'likedPoemIds', 'likedRadioTrackIds',
              'lastSeenAt', 'updatedAt'
            ])
            && (
              incoming().email == existing().email
              || (request.auth.token.email is string && incoming().email.lower() == request.auth.token.email.lower())
            )
          )
        );
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

