        && incoming().userId == request.auth.uid
        && voteId == (incoming().targetType + '__' + incoming().targetId + '__' + request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if isValidCompositeId(voteId) && isAdmin();
