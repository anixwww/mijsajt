          'title', 'content',
          'cycle', 'year', 'note', 'fontSize', 'textAlign', 'lineSpacing', 'textColor', 'backgroundColor',
          'imageUrl', 'imagePalette', 'soundcloudTrack', 'soundcloudTracks',
