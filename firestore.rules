          'ratingAverage', 'ratingCount', 'updatedAt'
        ])
        && data.id is string && data.id == highlightId && isValidId(data.id)
        && data.targetType is string && (data.targetType == 'poem' || data.targetType == 'prose')
        && data.weekKey is string && data.weekKey.size() >= 7 && data.weekKey.size() <= 10 && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && data.periodStart is string && data.periodStart.size() == 10 && data.periodStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.periodEnd is string && data.periodEnd.size() == 10 && data.periodEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 120
