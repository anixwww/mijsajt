    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && 'guestUid' in existing() && existing().guestUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.guestUid == request.auth.uid);
      allow create: if isValidId(orderId)
        && isSignedIn()
        && isValidOrder(incoming(), orderId)
        && (isAdmin() || ('guestUid' in incoming() && incoming().guestUid == request.auth.uid))
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);
      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidOrder(incoming(), orderId)
        && incoming().orderCode == existing().orderCode
        && incoming().createdAt == existing().createdAt
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
