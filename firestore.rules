      allow update: if isValidId(reviewId)
        && (isOwner(existing().authorUid) || isAdmin())
        && isValidReview(incoming(), reviewId)
        && incoming().id == existing().id
        && incoming().targetType == existing().targetType
        && incoming().targetId == existing().targetId
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'authorName', 'authorPhotoUrl']);
      allow delete: if isValidId(reviewId) && (isOwner(existing().authorUid) || isAdmin());
    }

    match /workVotes/{voteId} {
      allow get: if isValidCompositeId(voteId);
